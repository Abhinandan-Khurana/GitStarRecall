# GitHub OAuth app client ID
VITE_GITHUB_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must exactly match one callback URL configured in your GitHub OAuth app
# Example: http://localhost:5173/auth/callback
VITE_GITHUB_REDIRECT_URI=

# Backend endpoint that exchanges OAuth code + PKCE verifier for access token.
# This keeps client secret out of the browser.
VITE_GITHUB_OAUTH_EXCHANGE_URL=/api/github/oauth/exchange

# Embedding backend preference:
# - webgpu: try GPU backend first and fallback to wasm
# - wasm: force CPU/wasm only (kill switch)
VITE_EMBEDDING_BACKEND_PREFERRED=webgpu

# Optional embedding throughput tuning:
# - pool size is clamped to 1..2
# - worker batch size is clamped to 1..32
VITE_EMBEDDING_POOL_SIZE=1
VITE_EMBEDDING_WORKER_BATCH_SIZE=12
VITE_EMBEDDING_DB_WRITE_BATCH_SIZE=512
VITE_EMBEDDING_UI_UPDATE_MS=350
VITE_EMBEDDING_LARGE_LIBRARY_MODE=1
VITE_EMBEDDING_LARGE_LIBRARY_THRESHOLD=500
VITE_README_BATCH_PIPELINE_V2=0
VITE_README_BATCH_SIZE=40
VITE_EMBED_TRIGGER_THRESHOLD=256
VITE_EMBED_WINDOW_SIZE=512

# Optional Ollama embedding defaults.
# Ollama usage is controlled by in-app user toggle.
# Security gate: endpoint must be localhost / 127.0.0.1 / [::1].
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=nomic-embed-text
VITE_OLLAMA_TIMEOUT_MS=30000
VITE_WEBLLM_ENABLED=0

# Optional: key used to encrypt the stored LLM API key in localStorage (e.g. 32-byte hex or base64).
# If set, the remote provider API key is stored encrypted (bound to session + this key); if unset, the API key is not persisted.
# Note: this value is embedded in the client bundle; it protects against casual exfiltrators that only read localStorage, not against attackers with access to the app source.
VITE_LLM_SETTINGS_ENCRYPTION_KEY=
